# Maintainer: FiusDEV <support@fius.dev>
pkgname=fius
pkgver=1.0.10
pkgrel=1
pkgdesc="Your command center for controlling computers and services with natural language"
arch=('x86_64' 'aarch64')
url="https://fius.dev"
license=('MIT')
depends=('nodejs>=20' 'npm')
makedepends=()
options=(!emptydirs)
source=("https://registry.npmjs.org/@fiusdev/fius/-/fius-${pkgver}.tgz")
sha256sums=('SKIP')

package() {
    cd "$srcdir"
    npm install -g --user root --prefix "$pkgdir/usr" "@fiusdev/fius@${pkgver}"
}
