# Maintainer: FiusDEV <support@fius.dev>
pkgname=fius
pkgver=1.0.0
pkgrel=1
pkgdesc="Your command center for controlling computers and services with natural language"
arch=('x86_64' 'aarch64')
url="https://fius.dev"
license=('MIT')
depends=('nodejs>=20' 'npm')
makedepends=()
options=(!emptydirs)
source=("https://registry.npmjs.org/@fiusdev/fius/-/fiusdev-fius-${pkgver}.tgz")
sha256sums=('SKIP')

package() {
    cd "$srcdir"
    
    npm install -g --user root --prefix "$pkgdir/usr" "@fiusdev/fius@${pkgver}"
    
    rm -rf "$pkgdir/usr/lib/node_modules/@fiusdev/fius/node_modules/.package-lock.json"
}
