    "@fiusdev/client-sdk": "workspace:*",
    "@fiusdev/core": "workspace:*",
    "@fiusdev/image-local": "workspace:*",
    "@fiusdev/image-logger-agent": "workspace:*",
    "@fiusdev/llm": "workspace:*",
    "@fiusdev/registry": "workspace:*",
    "@fiusdev/server": "workspace:*",
    "@fiusdev/storage": "workspace:*",
    "@fiusdev/tui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "better-sqlite3": "^11.10.0",
    "boxen": "^7.1.1",
    "chalk": "^5.6.0",
    "commander": "^11.1.0",
    "dotenv": "^16.4.7",
    "fs-extra": "^11.3.0",
    "hono": "^4.12.12",
    "ioredis": "^5.7.0",
    "minimatch": "^10.2.3",
    "open": "^10.2.0",
    "pg": "^8.15.4",
    "posthog-node": "^4.2.1",
