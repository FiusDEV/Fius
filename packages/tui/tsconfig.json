{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "rootDir": "src",
        "outDir": "dist",
        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "exactOptionalPropertyTypes": false,
        "noImplicitAny": false,
        "noEmitOnError": false
    },
    "include": ["src/**/*"],
    "exclude": ["dist", "node_modules"]
}
